# Environments -----------------------------------------------------------------
# This project runs two tiers off ONE Sanity project (id below), separated by
# dataset:
#   - production : the live site (branch `main`)
#   - staging    : the staging site (branch `staging`)
# Locally and on the staging deploy, use the `staging` dataset; the production
# deploy uses `production`. Sanity tokens are project-scoped, so the same
# read/write tokens work for both datasets — only the dataset name and the
# per-env secrets/buckets below change between environments.

# Sanity ----------------------------------------------------------------------
# Copy this file to .env.local and fill in the values from https://sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=
# `staging` for local + staging deploy, `production` for the production deploy.
NEXT_PUBLIC_SANITY_DATASET=staging
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-12

# Optional: only needed when reading drafts or running mutations.
SANITY_API_READ_TOKEN=

# Required for the contact form to write submissions into Sanity. Create
# a token with "Editor" (or "Write") permissions in sanity.io/manage.
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook → cache revalidation route
# (/api/revalidate). Generate any random string, set it here AND as the
# "Secret" on the GROQ webhook in sanity.io/manage (API → Webhooks).
# Without it, on-demand revalidation falls back to the 1h time-based window.
#
# Use a DIFFERENT secret per environment, and create one webhook per dataset:
#   - production webhook → filtered to the `production` dataset, URL
#     https://<prod-domain>/api/revalidate, Secret = prod value
#   - staging webhook    → filtered to the `staging` dataset, URL
#     https://staging.<prod-domain>/api/revalidate, Secret = staging value
SANITY_REVALIDATE_SECRET=

# Cloudflare R2 ---------------------------------------------------------------
# Powers in-Studio video upload (the "Upload video to R2" button). Video bytes
# go to R2 instead of Sanity, so they don't bill against Sanity bandwidth.
#
# Use a SEPARATE bucket per environment so staging uploads never touch
# production media — e.g. "bpi-production" and "bpi-staging" — each with its
# own R2 API token and public base URL. The CORS policy on each bucket should
# allow PUT from that environment's Studio origin(s) (staging also allows
# http://localhost:3000 for local uploads).
#
# Setup in the Cloudflare dashboard (R2):
#   1. Create a bucket (e.g. "bpi-staging" / "bpi-production").
#   2. Give it a public URL: either enable the r2.dev dev URL, or (better)
#      connect a custom domain. That public base goes in R2_PUBLIC_BASE_URL.
#   3. Create an R2 API token (R2 → Manage API Tokens) with Object Read & Write
#      for the bucket → gives the Access Key ID + Secret. Account ID is in the
#      R2 overview / S3 endpoint.
#   4. Add a CORS policy on the bucket allowing PUT from the Studio origin(s):
#        [{ "AllowedOrigins": ["http://localhost:3000","https://YOUR-DOMAIN"],
#           "AllowedMethods": ["PUT"], "AllowedHeaders": ["*"] }]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the videos are served from (no trailing slash), e.g.
# https://pub-xxxx.r2.dev  or  https://media.your-domain.com
R2_PUBLIC_BASE_URL=

# Investor/Partner portal — PRIVATE bucket -----------------------------------
# Proprietary portal files/videos (reports, decks, briefings) must NEVER be
# publicly fetchable, so they live in a SEPARATE bucket with NO public domain
# mapped. They're served only through /api/portal/download, which checks the
# logged-in user's session + audience and mints a short-lived presigned GET URL.
# Reuses the same R2 account/credentials above; just a different bucket.
# Create e.g. "bpi-portal-staging" / "bpi-portal-production" and DO NOT attach a
# public r2.dev URL or custom domain to it. CORS only needs PUT from the Studio
# origin(s) for admin uploads.
R2_PRIVATE_BUCKET=

# Investor/Partner portal — auth & email -------------------------------------
# Random 32+ byte secret that signs the portal session cookie AND the one-time
# magic-link tokens (jose HS256). Generate with: openssl rand -base64 48
# Rotating it invalidates all existing sessions and pending magic links.
PORTAL_SESSION_SECRET=

# Magic links are emailed via Resend (https://resend.com). Create an API key and
# verify the sending domain, then set the key + a verified From address.
# Until these are set, the login page returns the neutral "check your email"
# message but no email is actually sent (the request no-ops, logged server-side).
RESEND_API_KEY=
PORTAL_FROM_EMAIL=BPI Portal <portal@barbadospharmainc.org>

# Absolute base URL used to build magic-link URLs in emails (no trailing slash),
# e.g. https://staging.barbadospharmainc.org or http://localhost:3000 for local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview/dev BYPASS — set to 1 to expose a "Preview the portal" button on the
# login page (and the /portal/dev-login route) that signs you in as a synthetic
# investor+partner user, no email or Sanity account needed. For previewing the
# UI only. ⚠️ NEVER set this in production — it grants full portal access to
# anyone. Leave blank everywhere except local/preview.
PORTAL_DEV_BYPASS=

# Eventbrite ------------------------------------------------------------------
# Events are authored in Sanity and pushed to Eventbrite on publish (the
# /api/eventbrite-sync webhook creates/publishes the Eventbrite event, then
# writes its id + URL back into the Sanity doc). Editors never open Eventbrite.
#
# Until these are set, the events page renders placeholder/empty content and the
# sync webhook no-ops — so the feature can ship before the account exists.
#
# Setup:
#   1. Create/own an Eventbrite organization for BPI.
#   2. Private API token: Eventbrite → Account Settings → Developer → API Keys
#      → "Your private token". Paste below as EVENTBRITE_API_TOKEN.
#   3. Organization ID: call
#        curl -H "Authorization: Bearer <token>" \
#          https://www.eventbriteapi.com/v3/users/me/organizations/
#      and copy the org's `id`. Paste as EVENTBRITE_ORGANIZATION_ID.
#   4. Paid tickets require payout/banking to be configured on the Eventbrite
#      account before paid events can publish (free events work without it).
#
# The token is project-scoped, so the same value works for staging + prod; point
# each environment at its own organization if you want them isolated.
EVENTBRITE_API_TOKEN=
EVENTBRITE_ORGANIZATION_ID=

# Shared secret for the Sanity → Eventbrite sync webhook (/api/eventbrite-sync).
# Generate any random string and set it as the "Secret" on a GROQ webhook
# filtered to `_type == "event"`, projecting { _type, _id }. If unset, the route
# falls back to SANITY_REVALIDATE_SECRET so it can share the revalidate webhook.
EVENTBRITE_SYNC_SECRET=
