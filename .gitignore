# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the committed template so new clones get it.
!.env.example

# vercel
.vercel

# large local video sources — these belong in Cloudflare R2 (uploaded via the
# in-Studio uploader), not git. GitHub also hard-blocks files over 100MB.
/public/videos/
*.mov
*.mp4

# typescript
*.tsbuildinfo
next-env.d.ts
